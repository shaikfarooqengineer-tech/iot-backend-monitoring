# ─────────────────────────────────────────────────────────────────
# FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────
# IMPORTANT: This file is committed to git (no secrets here).
# The actual production backend URL is set via Vercel Dashboard →
# Project Settings → Environment Variables for security.
#
# To set in Vercel Dashboard:
#   Name:  REACT_APP_BACKEND_URL
#   Value: https://sleep-monitoring-backend.vercel.app
#   Scope: Production (and Preview if needed)
# ─────────────────────────────────────────────────────────────────

REACT_APP_BACKEND_URL=https://sleep-monitoring-backend.vercel.app

# Polling interval in ms when WebSocket is unavailable (3000 = 3 seconds)
REACT_APP_POLL_INTERVAL_MS=3000

# Maximum WebSocket reconnection attempts before falling back to polling
REACT_APP_WS_MAX_RETRIES=3
